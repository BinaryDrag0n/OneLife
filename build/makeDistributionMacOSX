#!/bin/sh

#
# Modification History
#
# 2007-November-12   Jason Rohrer
# Copied from Cultivation build.
#


if [ $# -lt 2 ] ; then
   echo "Usage: $0 release_name unix_platform_name"
   exit 1
fi


rm -rf mac/2HOL_$1


./makeBaseDistributionFolder $1


mv base/* mac


cd ../gameSource
sh makeRegenerateCaches

cd ../build/mac/2HOL_$1


# mac version now defaults to windowed mode
# too many problems and crashes will fullscreen
echo "0" > settings/fullscreen.ini


../../../gameSource/regenerateCaches

# don't ever include bin_cache in bundles, because they are large
# and change every update
rm */bin_*cache.fcz

cd ../..


cp -r macOSX/OneLife.app mac/2HOL_$1/2HOL_$1.app
cp ../gameSource/OneLife mac/2HOL_$1/2HOL_$1.app/Contents/MacOS

rm -r mac/2HOL_$1/2HOL_$1.app/Contents/MacOS/empty.txt
rm -r mac/2HOL_$1/2HOL_$1.app/Contents/Frameworks/empty.txt

BREW_PREFIX=`brew --prefix 2>/dev/null || echo /usr/local`

APP_BUNDLE=mac/2HOL_$1/2HOL_$1.app
GAME_BINARY=$APP_BUNDLE/Contents/MacOS/OneLife

targets=$GAME_BINARY

while [ -n "$targets" ] ; do

    nextTargets=""

    for target in $targets ; do

        for lib in `otool -L $target | tail -n +2 | awk '{print $1}' | grep "^$BREW_PREFIX/"` ; do

            libName=`basename $lib`
            bundledLib=$APP_BUNDLE/Contents/Frameworks/$libName

            if [ ! -f $bundledLib ] ; then
                cp -f $lib $bundledLib

                # brew installs these read-only
                chmod u+w $bundledLib

                install_name_tool -id @executable_path/../Frameworks/$libName \
                    $bundledLib

                nextTargets="$nextTargets $bundledLib"
            fi

            install_name_tool -change $lib \
                @executable_path/../Frameworks/$libName $target
        done
    done

    targets=$nextTargets
done


# install_name_tool invalidates the signature the linker applied, and an
# arm64 binary will not run at all without a valid one, so re-sign ad-hoc.
codesign --force --deep --sign - $APP_BUNDLE


cd mac


d=`date`

echo "$1 built on $d" > 2HOL_$1/binary.txt


tar cf "2HOL_$1_$2.tar" 2HOL_$1
gzip "2HOL_$1_$2.tar"






